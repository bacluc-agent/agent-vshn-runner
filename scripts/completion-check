#!/usr/bin/env bash
set -Eeuo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

mount=(-v "$PWD:/workspace" -w /workspace)
status=0

check() {
  local name="$1"
  shift
  printf '==> %s\n' "$name"
  if "$@"; then
    printf 'PASS: %s\n' "$name"
  else
    printf 'FAIL: %s\n' "$name" >&2
    status=1
  fi
}

check 'formatting (prettier --check .)' docker run --rm "${mount[@]}" ghcr.io/bacluc/prettier-image/prettier-image:3.9.4 --check .
check 'actionlint (workflows + used actions)' docker run --rm "${mount[@]}" rhysd/actionlint:1.7.12 -color
if [[ ! -d .opencode/node_modules/@opencode-ai/plugin ]]; then
  check 'opencode node dependencies (npm install)' npm install --prefix .opencode
fi
check 'opencode tool tests (node --test)' node --test ".opencode/tool/*.test.mjs"
check 'pytest (python tests)' uv run --group dev pytest -q .github/actions/model-availability scripts

exit "$status"
